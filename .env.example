# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Feature Flags
ELSEWHERE_ENVIRONMENT=dev
ELSEWHERE_ENABLE_FUNNEL_TELEMETRY=true
ELSEWHERE_ENABLE_ASSIST_AUTO_EXECUTION=true

# Financing Provider Keys (Phase 2)
UPLIFT_API_KEY=
KLARNA_API_KEY=
AFFIRM_API_KEY=

# Replicate (face-personalized previews)
REPLICATE_API_TOKEN=

# Face Personalization Feature Flag
ELSEWHERE_ENABLE_FACE_PERSONALIZATION=true

# Webhook Secrets
FINANCING_WEBHOOK_SECRET=
ASSIST_WEBHOOK_SECRET=

# Mobile (Expo) — point to dev API. Use LAN IP on real device, localhost on simulator.
EXPO_PUBLIC_API_URL=http://localhost:3002
