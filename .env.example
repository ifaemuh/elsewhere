REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SERPAPI_API_KEY=
TAVILY_API_KEY=
AI_GATEWAY_API_KEY=
ELSEWHERE_ENABLE_DEFAULT_DEAL_FEEDS=false
ELSEWHERE_DEAL_FEED_URLS=

# Hosted Trip Chat
# Supported planned adapters: mock, stream, sendbird.
ELSEWHERE_CHAT_PROVIDER=mock
