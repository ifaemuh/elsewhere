AFFIRM_API_KEY=

# Travel Intelligence Providers
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
DUFFEL_ACCESS_TOKEN=
FLIGHTAWARE_API_KEY=
